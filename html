<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Your Name</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Inter', -apple-system, sans-serif;
        }

        body {
            line-height: 1.6;
            color: #000;
            background-color: #fff;
        }

        header {
            background-color: #fff;
            border-bottom: 1px solid #000;
            padding: 2rem 1rem;
            position: sticky;
            top: 0;
            z-index: 100;
        }

        nav {
            max-width: 900px;
            margin: 0 auto;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .logo {
            font-size: 1.2rem;
            font-weight: 400;
            letter-spacing: -0.5px;
        }

        .nav-links {
            display: flex;
            gap: 3rem;
        }

        .nav-links a {
            text-decoration: none;
            color: #000;
            font-size: 0.9rem;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .nav-links a:hover {
            text-decoration: underline;
        }

        main {
            max-width: 900px;
            margin: 0 auto;
            padding: 4rem 1rem;
        }

        #intro {
            margin-bottom: 6rem;
        }

        #intro h1 {
            font-size: 3rem;
            font-weight: 500;
            letter-spacing: -1px;
            line-height: 1.2;
            max-width: 600px;
            margin-bottom: 2rem;
        }

        .bio {
            font-size: 1.2rem;
            max-width: 600px;
            color: #444;
        }

        .section {
            margin-bottom: 6rem;
            opacity: 0;
            transform: translateY(10px);
            transition: opacity 0.8s, transform 0.8s;
        }

        .section.visible {
            opacity: 1;
            transform: translateY(0);
        }

        .section h2 {
            font-size: 2rem;
            font-weight: 400;
            margin-bottom: 2rem;
            letter-spacing: -0.5px;
        }

        .article-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 3rem;
        }

        .article-card {
            border-top: 1px solid #000;
            padding-top: 1.5rem;
        }

        .article-card .date {
            font-size: 0.8rem;
            color: #666;
            display: block;
            margin-bottom: 0.5rem;
        }

        .article-card h3 {
            font-size: 1.1rem;
            font-weight: 400;
            margin-bottom: 1rem;
        }

        .article-card p {
            font-size: 0.9rem;
            color: #444;
            margin-bottom: 1rem;
        }

        .article-card .note {
            font-style: italic;
        }

        .read-more {
            display: inline-block;
            color: #000;
            text-decoration: none;
            font-size: 0.8rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            transition: opacity 0.3s;
        }

        .read-more:hover {
            opacity: 0.6;
        }

        .follow-list {
            display: flex;
            flex-direction: column;
            gap: 1rem;
        }

        .follow-item {
            display: flex;
            justify-content: space-between;
            text-decoration: none;
            color: #000;
            padding: 0.5rem 0;
            border-bottom: 1px solid #eee;
        }

        .follow-item:hover {
            background-color: #fafafa;
        }

        .follow-item .name {
            font-weight: 500;
        }

        .follow-item .handle {
            color: #666;
            font-size: 0.9rem;
        }

        @media (max-width: 768px) {
            .nav-links {
                display: none;
            }

            #intro h1 {
                font-size: 2rem;
            }

            .section h2 {
                font-size: 1.5rem;
            }

            .bio {
                font-size: 1rem;
            }
        }
    </style>
</head>
<body>
    <header>
        <nav>
            <div class="logo">Your Name</div>
            <div class="nav-links">
                <a href="#essays">Essays</a>
                <a href="#reading">Reading List</a>
                <a href="#follow">Who to Follow</a>
            </div>
        </nav>
    </header>

    <main>
        <section id="intro" class="section">
            <h1>Building things that matter.</h1>
            <p class="bio">I write about technology, culture, and the intersection of both. Currently working on [Your Project/Company]. Previously at [Past Experience].</p>
        </section>

        <section id="essays" class="section">
            <h2>Essays</h2>
            <div class="article-grid">
                <article class="article-card">
                    <span class="date">Jan 2024</span>
                    <h3>The Future of Personal Computing</h3>
                    <p>Exploring how emerging technologies will reshape our daily interactions with computers.</p>
                    <a href="#" class="read-more">Read Essay</a>
                </article>
                <article class="article-card">
                    <span class="date">Dec 2023</span>
                    <h3>Building in Public</h3>
                    <p>Lessons learned from sharing work in progress and developing in the open.</p>
                    <a href="#" class="read-more">Read Essay</a>
                </article>
            </div>
        </section>

        <section id="reading" class="section">
            <h2>Reading List</h2>
            <div class="article-grid">
                <article class="article-card">
                    <h3>Zero to One</h3>
                    <p>Peter Thiel</p>
                    <p class="note">Notes on startups, or how to build the future. Essential reading for understanding value creation.</p>
                </article>
                <article class="article-card">
                    <h3>Snow Crash</h3>
                    <p>Neal Stephenson</p>
                    <p class="note">A science fiction classic that predicted many aspects of our digital world.</p>
                </article>
            </div>
        </section>

        <section id="follow" class="section">
            <h2>Who to Follow</h2>
            <div class="article-grid">
                <article class="article-card">
                    <h3>Tech Insights</h3>
                    <div class="follow-list">
                        <a href="#" class="follow-item">
                            <span class="name">Paul Graham</span>
                            <span class="handle">@paulg</span>
                        </a>
                        <a href="#" class="follow-item">
                            <span class="name">Marc Andreessen</span>
                            <span class="handle">@pmarca</span>
                        </a>
                    </div>
                </article>
                <article class="article-card">
                    <h3>Builders & Creators</h3>
                    <div class="follow-list">
                        <a href="#" class="follow-item">
                            <span class="name">Patrick Collison</span>
                            <span class="handle">@patrickc</span>
                        </a>
                        <a href="#" class="follow-item">
                            <span class="name">Naval Ravikant</span>
                            <span class="handle">@naval</span>
                        </a>
                    </div>
                </article>
            </div>
        </section>
    </main>

    <script>
        // Intersection Observer for scroll animations
        const sections = document.querySelectorAll('.section');
                
        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.classList.add('visible');
                }
            });
        }, {
            threshold: 0.1
        });

        sections.forEach(section => {
            observer.observe(section);
        });

        // Smooth scrolling for navigation links
        document.querySelectorAll('a[href^="#"]').forEach(anchor => {
            anchor.addEventListener('click', function (e) {
                e.preventDefault();
                document.querySelector(this.getAttribute('href')).scrollIntoView({
                    behavior: 'smooth'
                });
            });
        });
    </script>
</body>
</html>
